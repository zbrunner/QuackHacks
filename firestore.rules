rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidListItem() {
      return request.resource.data.keys().hasAll(['text', 'addedBy', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.addedBy == request.auth.uid;
    }

    function pairListDoc(pairId) {
      return get(/databases/$(database)/documents/pairLists/$(pairId));
    }

    function isPairMember(pairId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/pairLists/$(pairId)) &&
        request.auth.uid in pairListDoc(pairId).data.members;
    }

    // Allow reads when the pair list has not been created yet (empty shared list).
    function canReadPairList(pairId) {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/pairLists/$(pairId)) ||
        request.auth.uid in pairListDoc(pairId).data.members
      );
    }

    match /pairLists/{pairId} {
      allow read: if canReadPairList(pairId);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 2;
      allow update, delete: if false;

      match /items/{itemId} {
        allow read, delete: if canReadPairList(pairId);
        allow create: if isPairMember(pairId) && isValidListItem();
        allow update: if false;
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /connections/{connectionId} {
        allow read: if isOwner(userId);
        allow create, update: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == connectionId);
        allow delete: if isOwner(userId);
      }

      match /incomingRequests/{fromId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn() && request.auth.uid == fromId;
        allow delete: if isOwner(userId) || request.auth.uid == fromId;
      }

      match /outgoingRequests/{toId} {
        allow read, create: if isOwner(userId);
        allow delete: if isOwner(userId) || request.auth.uid == toId;
      }

      match /personalList/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidListItem();
        allow update: if false;
      }
    }
  }
}
